# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
test-results/
playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dms-engine (old build) static assets — CS concept content only (T3.13
# removed this script's `pages[]`/`sharedComponents[]` jobs, which is why
# there's no longer an `/app/solutions/` or diagram-assets ignore here: the
# generated-pages route is gone, replaced by the hand-written one below).
/public/engine/

# dms-engine v3 output, synced at build time by sync-engine-v3.js. Never
# commit these: `data/engine/` is the public view-data/runtime bytes,
# `server-data/engine/` never leaves the server.
/data/engine/
/server-data/engine/
